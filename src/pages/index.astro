---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kailey Liou">
  <nav>
    <div class="container nav-inner">
      <a href="#welcome" class="nav-logo">Kailey Liou</a>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="https://github.com/KaileyLiou" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="25" height="25" fill="currentColor">
            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .31.21.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <section id="welcome" class="container welcome">
    <h1>
      <span class="lead-in">hi, i'm</span>
      Kailey Liou
    </h1>

    <p class="tagline">
      I'm <span id="typing-word" class="typing-word"></span><span class="cursor">|</span>
    </p>

    <p class="hero-bio">
      I'm a high school senior in New York City with a strong interest in computer science and STEM.
    </p>

    <a href="#projects" class="cta">See my projects ↓</a>
  </section>

  <section id="about" class="container">
    <h2>About</h2>
  </section>

  <section id="projects" class="container">
    <h2>Projects</h2>
  </section>

  <style>
    nav {
      position: sticky;
      top: 0;
      background: var(--color-cream);
      border-bottom: 1px solid rgba(22, 40, 58, 0.1);
      z-index: 10;
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-block: var(--space-sm);
    }

    .nav-logo {
      font-family: var(--font-display);
      font-weight: 600;
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      gap: var(--space-md);
    }

    .nav-links a {
      text-decoration: none;
      font-weight: 500;
    }

    section {
      min-height: 60vh;
      padding-block: var(--space-xl);
    }

    .welcome {
      display: flex;
      flex-direction: column;
      align-items: left;
      text-align: left;
      justify-content: left;
      gap: var(--space-sm);
      min-height: 60vh;
    }

    .typing {
      color: var(--color-blue);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.9rem;
    }

    .welcome h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .lead-in {
      font-size: 0.4em;
      font-weight: 500;
      color: var(--color-blue-dark);
    }

    .tagline {
      font-size: clamp(1.3rem, 3vw, 2rem);
      font-family: var(--font-display);
      color: var(--color-blue-dark);
    }

    .cursor {
      color: var(--color-yellow);
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    .welcome-bio {
      max-width: 42ch;
      color: var(--color-ink);
      opacity: 0.85;
    }

    .cta {
      margin-inline: auto;
    }

    .cta:hover {
      background: var(--color-blue-dark);
    }
  </style>

  <script>
    class TypingEffect {
      private el: HTMLElement;
      private words: string[];
      private wordIndex = 0;
      private charIndex = 0;
      private deleting = false;

      constructor(el: HTMLElement, words: string[]) {
        this.el = el;
        this.words = words;
        this.tick();
      }

      private tick() {
        const currentWord = this.words[this.wordIndex];

        this.charIndex += this.deleting ? -1 : 1;
        this.el.textContent = currentWord.slice(0, this.charIndex);

        let delay = this.deleting ? 40 : 80;

        if (!this.deleting && this.charIndex === currentWord.length) {
          delay = 1400;
          this.deleting = true;
        } else if (this.deleting && this.charIndex === 0) {
          this.deleting = false;
          this.wordIndex = (this.wordIndex + 1) % this.words.length;
          delay = 300;
        }

        setTimeout(() => this.tick(), delay);
      }
    }

    const wordEl = document.querySelector<HTMLElement>('#typing-word');
    if (wordEl) {
      new TypingEffect(wordEl, [
        'a coder.',
		'a hackathon organizer.',
        'a graphic designer.',
        'a runner.',
        'a pianist.',
		'a peer tutor.',
      ]);
    }
  </script>

</Layout>