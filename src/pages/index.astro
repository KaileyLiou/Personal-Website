---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Nav from '../components/Nav.astro';
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.featured);

const carouselItems = [
  ...featured.map((p) => ({ ...p, isDuplicate: false })),
  ...featured.map((p) => ({ ...p, isDuplicate: true })),
];
---

<Layout title="Kailey Liou">
<Nav />

  <section id="welcome" class="welcome">
    <div class="container welcome-inner">
      <h1>Kailey Liou</h1>

      <p class="tagline">
        I'm <span id="typing-word" class="typing-word"></span><span class="cursor">|</span>
      </p>

      <a href="#projects" class="btn-outline">See my projects ↓</a>
    </div>
  </section>

  <section id="about" class="about-band">
    <div class="container about-inner">
      <p>
        I am a high school senior in New York City with a strong interest in computer science and STEM, especially cybersecurity and AI/ML. In my free time, I enjoy coding, organizing hackathons, tutoring, running, and graphic designing.
      </p>
    </div>
  </section>

  <section id="projects">
  	<div class="container">
    	<h2>Projects</h2>
	  </div>

    <div class="carousel">
      <div class="carousel-track" id="carousel-track">
        {carouselItems.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>

      <div class="carousel-controls">
        <button id="carousel-prev" class="carousel-btn" aria-label="Previous project">←</button>
        <button id="carousel-pause" class="carousel-btn" aria-label="Pause carousel">⏸</button>
        <button id="carousel-next" class="carousel-btn" aria-label="Next project">→</button>
      </div>

      <div class="container all-projects">
        <a href="/projects/" class="btn-outline">See all projects →</a>
      </div>
    </div>
  </section>

  <style>
    .all-projects {
      text-align: center;
      margin-top: var(--space-md);
    }
    section {
      padding-block: var(--space-xl);
    }

	  .welcome {
      min-height: 55vh;
      background-image: radial-gradient(circle, rgba(29, 111, 143, 0.25) 1.3px, transparent 1px);
      background-size: 24px 24px;
      display: flex;
      align-items: center;
    }

    .welcome-inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      gap: var(--space-sm);
      width: 100%;
    }

    .typing {
      color: var(--color-blue);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.9rem;
    }

    .welcome h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .lead-in {
      font-size: 0.4em;
      font-weight: 500;
      color: var(--color-blue-dark);
    }

    .tagline {
      font-size: clamp(1.3rem, 3vw, 2rem);
      font-family: var(--font-display);
      color: var(--color-blue-dark);
    }

    .cursor {
      color: var(--color-yellow);
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    .cta {
      margin-inline: auto;
    }

    .cta:hover {
      background: var(--color-blue-dark);
    }

    .about-band {
      background: var(--color-blue);
      color: var(--color-cream);
      padding-block: calc(var(--space-xl) * 1.5);
      background-image:
      linear-gradient(rgba(251, 246, 236, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251, 246, 236, 0.12) 1px, transparent 1px);
      background-size: 32px 32px;
    }

    .about-inner {
      max-width: 700px;
      margin-inline: auto;
      text-align: center;
    }

    .about-inner p {
      font-size: clamp(1.1rem, 2.5vw, 1.4rem);
      line-height: 1.6;
    }

    .carousel {
      margin-top: var(--space-lg);
    }

    .carousel-track {
      display: flex;
      justify-content: safe center;
      gap: var(--space-md);
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: none;
      padding-bottom: var(--space-sm);
      padding-inline: var(--space-sm);
      scrollbar-width: none;
      mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    }

    .carousel-track.snap-enabled {
      scroll-snap-type: x mandatory;
    }

    .carousel-track::-webkit-scrollbar {
      display: none; /* hides the scrollbar in chrome and safari */
    }

    .carousel-track :global(.project-card) {
      flex: 0 0 clamp(260px, 32vw, 340px);
      scroll-snap-align: start;
    }

    .carousel-controls {
      display: flex;
      justify-content: center;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }

    .carousel-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      background: var(--color-surface);
      color: var(--color-blue-dark);
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .carousel-btn:hover {
      background: var(--color-blue);
      color: var(--color-cream);
    }
  </style>

  <script>
    class TypingEffect {
      private el: HTMLElement;
      private words: string[];
      private wordIndex = 0;
      private charIndex = 0;
      private deleting = false;

      constructor(el: HTMLElement, words: string[]) {
        this.el = el;
        this.words = words;
        this.tick();
      }

      private tick() {
        const currentWord = this.words[this.wordIndex];

        this.charIndex += this.deleting ? -1 : 1;
        this.el.textContent = currentWord.slice(0, this.charIndex);

        let delay = this.deleting ? 40 : 80;

        if(!this.deleting && this.charIndex === currentWord.length) {
          delay = 1400;
          this.deleting = true;
        } else if(this.deleting && this.charIndex === 0) {
          this.deleting = false;
          this.wordIndex = (this.wordIndex + 1) % this.words.length;
          delay = 300;
        }

        setTimeout(() => this.tick(), delay);
      }
    }

    const wordEl = document.querySelector<HTMLElement>('#typing-word');
    if(wordEl) {
      new TypingEffect(wordEl, [
        'a coder.',
		    'a hackathon organizer.',
		    'a peer tutor.',
        'a graphic designer.',
        'a runner.',
		    'a racewalker.',
        'a pianist.',
      ]);
    }

    class Carousel {
      private track: HTMLElement;
      private prevBtn: HTMLButtonElement;
      private nextBtn: HTMLButtonElement;
      private pauseBtn: HTMLButtonElement;
      private isPaused = false;
      private isVisible = false;
      private rafId: number | null = null;
      private speed = 3;

      constructor(track: HTMLElement, prevBtn: HTMLButtonElement, nextBtn: HTMLButtonElement, pauseBtn: HTMLButtonElement) {
        this.track = track;
        this.prevBtn = prevBtn;
        this.nextBtn = nextBtn;
        this.pauseBtn = pauseBtn;
        this.bindEvents();
        this.observeVisibility();
      }

      private observeVisibility() {
        const observer = new IntersectionObserver(
          (entries) => {
            this.isVisible = entries[0].isIntersecting;
            if(this.isVisible && !this.isPaused) {
				      this.play();
			      }
            else {
				      this.stop();
			      }
          },
          { threshold: 0.3 } // visible when 30% is on screen
        );
        observer.observe(this.track);
      }

      private bindEvents() {
        this.track.addEventListener('mouseenter', () => this.stop());
        this.track.addEventListener('mouseleave', () => {
          if(!this.isPaused && this.isVisible) {
			      this.play();
		      }
        });
        this.pauseBtn.addEventListener('click', () => this.togglePause());
        this.prevBtn.addEventListener('click', () => this.step(-1));
        this.nextBtn.addEventListener('click', () => this.step(1));

        document.addEventListener('visibilitychange', () => {
          if(document.hidden) {
			      this.stop();
		      }
          else if(!this.isPaused && this.isVisible) {
			      this.play();
		      }
        });
      }

      private play() {
        this.track.classList.remove('snap-enabled');
        if(this.rafId !== null) {
          return;
        }

        const tick = () => {
          this.track.scrollLeft += this.speed;
          const singleSetWidth = this.track.scrollWidth / 2;
    
          if(this.track.scrollLeft >= singleSetWidth) {
            this.track.style.scrollBehavior = 'auto';
            this.track.scrollLeft -= singleSetWidth;
            this.track.style.scrollBehavior = '';
          }
          this.rafId = requestAnimationFrame(tick);
        };
        this.rafId = requestAnimationFrame(tick);
      }

      private stop() {
        if(this.rafId !== null) {
          cancelAnimationFrame(this.rafId);
          this.rafId = null;
        }
      }

      private togglePause() {
        this.isPaused = !this.isPaused;
        if(this.isPaused) {
          this.stop();
          this.track.classList.add('snap-enabled');
          this.pauseBtn.textContent = '▶';
          this.pauseBtn.setAttribute('aria-label', 'Play carousel');
        }
        else {
          if(this.isVisible) {
            this.play();
          }
          this.pauseBtn.textContent = '⏸';
          this.pauseBtn.setAttribute('aria-label', 'Pause carousel');
        }
      }

      private step(direction: 1 | -1) {
        this.isPaused = true;
        this.stop();
        this.track.classList.add('snap-enabled');
        this.pauseBtn.textContent = '▶';
        this.pauseBtn.setAttribute('aria-label', 'Play carousel');

        const card = this.track.querySelector<HTMLElement>('.project-card');
        if(!card) {
          return;
        }

        const gap = parseFloat(getComputedStyle(this.track).gap || '0');
        const distance = card.getBoundingClientRect().width + gap;
        this.track.scrollBy({ left: direction * distance, behavior: 'smooth' });
      }
	}

    const track = document.querySelector<HTMLElement>('#carousel-track');
    const prevBtn = document.querySelector<HTMLButtonElement>('#carousel-prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('#carousel-next');
    const pauseBtn = document.querySelector<HTMLButtonElement>('#carousel-pause');

    if(track && prevBtn && nextBtn && pauseBtn) {
      new Carousel(track, prevBtn, nextBtn, pauseBtn);
    } 
	  else {
      console.error('Carousel: one or more elements not found', { track, prevBtn, nextBtn, pauseBtn }); // debugging
    }
  </script>

</Layout>