---
import Layout from '../layouts/Layout.astro';

interface Project {
  title: string;
  description: string;
  tag: string;
  link: string;
  githubLink?: string;
  image: string;
}

const projects: Project[] = [
  {
    title: "Screens + Shots",
    description: "A health reminder app that helps people stay on top of vaccines and cancer screenings.",
    link: "https://apps.apple.com/us/app/screens-shots/id6755749446",
    githubLink: "https://github.com/KaileyLiou/Screens-Shots",
	image: "/projects/screens_shots2.png",
  },
  {
    title: "σ Orionis DBNets Analysis",
    description: "Python-based data analysis to evaluate DBNets2.0 for the σ Orionis star-forming region.",
    link: "https://drive.google.com/file/d/1OIrOtCjfVbmraP_URJOdOphN46_qVPAs/view?usp=sharing",
    githubLink: "https://github.com/KaileyLiou/sigma-orionis-dbnets",
	image: "/projects/sigma_orionis.png",
  },
  {
    title: "Sea Turtles Website",
    description: "An interactive SvelteKit website on endangered sea turtles with a rotating facts panel and a quiz.",
    link: "https://kaileyliou.github.io/Turtles/",
    githubLink: "https://github.com/KaileyLiou/Turtles",
	image: "/projects/turtles.png",
  },
  {
    title: "Sprig Maze",
    description: "A 14-level maze game built on Hack Club's Sprig hardware where the goal is to get the green pea to the boba.",
    link: "https://sprig.hackclub.com/share/3AWmEEVINE324649XdZ6",
    githubLink: "https://github.com/KaileyLiou/sprig-maze",
	image: "/projects/sprig.jpg",
  },
];
---

<Layout title="Kailey Liou">
  <nav>
    <div class="container nav-inner">
      <a href="#welcome" class="nav-logo">Kailey Liou</a>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="https://github.com/KaileyLiou" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="25" height="25" fill="currentColor">
            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .31.21.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <section id="welcome" class="welcome">
    <div class="container welcome-inner">
      <h1>Kailey Liou</h1>

      <p class="tagline">
        I'm <span id="typing-word" class="typing-word"></span><span class="cursor">|</span>
      </p>

      <a href="#projects" class="cta">See my projects ↓</a>
    </div>
  </section>

  <section id="about" class="about-band">
    <div class="container about-inner">
      <p>
        I am a high school senior in New York City with a strong interest in computer science and STEM,
		especially cybersecurity and AI/ML. In my free time, I enjoy coding, organizing hackathons, tutoring,
		running, and graphic designing.
      </p>
    </div>
  </section>

  <section id="projects" class="container">
    <h2>Projects</h2>

    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-image-link">
            <img src={project.image} alt={`screenshot of ${project.title}`} class="project-image" loading="lazy"/>
          </a>

          <div class="project-card-body">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
			
			<div class="project-card-footer">
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-view-link">
                View project →
              </a>
              {project.githubLink && (
                <a href={project.githubLink} target="_blank" rel="noopener noreferrer" aria-label="View source code" class="project-github">
                  <!-- size of github icon -->
				  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .31.21.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <style>
    nav {
      position: sticky;
      top: 0;
      background: var(--color-cream);
      border-bottom: 1px solid rgba(22, 40, 58, 0.1);
      z-index: 10;
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-block: var(--space-sm);
    }

    .nav-logo {
      font-family: var(--font-display);
      font-weight: 600;
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      gap: var(--space-md);
    }

    .nav-links a {
      text-decoration: none;
      font-weight: 500;
    }

    section {
      padding-block: var(--space-xl);
    }

	.welcome {
      min-height: 55vh;
      background-image: radial-gradient(circle, rgba(29, 111, 143, 0.25) 1.3px, transparent 1px);
      background-size: 24px 24px;
      display: flex;
      align-items: center;
    }

    .welcome-inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      gap: var(--space-sm);
      width: 100%;
    }

    .typing {
      color: var(--color-blue);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.9rem;
    }

    .welcome h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .lead-in {
      font-size: 0.4em;
      font-weight: 500;
      color: var(--color-blue-dark);
    }

    .tagline {
      font-size: clamp(1.3rem, 3vw, 2rem);
      font-family: var(--font-display);
      color: var(--color-blue-dark);
    }

    .cursor {
      color: var(--color-yellow);
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    .cta {
      margin-inline: auto;
    }

    .cta:hover {
      background: var(--color-blue-dark);
    }

    .about-band {
      background: var(--color-blue);
      color: var(--color-cream);
      padding-block: calc(var(--space-xl) * 1.5);
      background-image:
        linear-gradient(rgba(251, 246, 236, 0.12) 1px, transparent 1px),
        linear-gradient(90deg, rgba(251, 246, 236, 0.12) 1px, transparent 1px);
      background-size: 32px 32px;
    }

    .about-inner {
      max-width: 700px;
      margin-inline: auto;
      text-align: center;
    }

    .about-inner p {
      font-size: clamp(1.1rem, 2.5vw, 1.4rem);
      line-height: 1.6;
    }

	.project-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: var(--space-md);
      margin-top: var(--space-lg);
    }

    .project-card {
      display: flex;
      flex-direction: column;
      background: var(--color-surface);
      border-radius: var(--radius);
      overflow: hidden;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .project-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(22, 40, 58, 0.1);
    }

    .project-image-link {
      display: block;
    }

    .project-image {
      aspect-ratio: 16 / 10;
      width: 100%;
      object-fit: cover;
      display: block;
    }

    .project-card-body {
      padding: var(--space-md);
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .project-card h3 {
      font-size: 1.2rem;
      margin-bottom: var(--space-sm);
    }

    .project-card p {
      font-size: 0.9rem;
      opacity: 0.8;
      line-height: 1.5;
    }

    .project-card-footer {
      margin-top: auto;
      display: flex;
      align-items: center;
      padding-top: var(--space-sm);
    }

    .project-links {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }

    .project-view-link {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-blue);
      text-decoration: none;
    }

    .project-github {
      margin-left: auto;
      color: var(--color-blue-dark);
      opacity: 0.6;
      text-decoration: none;
    }

    .project-view-link:hover {
      text-decoration-line: underline;
      text-decoration-style: wavy;
      text-decoration-color: var(--color-yellow);
      text-underline-offset: 4px;
    }
  </style>

  <script>
    class TypingEffect {
      private el: HTMLElement;
      private words: string[];
      private wordIndex = 0;
      private charIndex = 0;
      private deleting = false;

      constructor(el: HTMLElement, words: string[]) {
        this.el = el;
        this.words = words;
        this.tick();
      }

      private tick() {
        const currentWord = this.words[this.wordIndex];

        this.charIndex += this.deleting ? -1 : 1;
        this.el.textContent = currentWord.slice(0, this.charIndex);

        let delay = this.deleting ? 40 : 80;

        if (!this.deleting && this.charIndex === currentWord.length) {
          delay = 1400;
          this.deleting = true;
        } else if (this.deleting && this.charIndex === 0) {
          this.deleting = false;
          this.wordIndex = (this.wordIndex + 1) % this.words.length;
          delay = 300;
        }

        setTimeout(() => this.tick(), delay);
      }
    }

    const wordEl = document.querySelector<HTMLElement>('#typing-word');
    if (wordEl) {
      new TypingEffect(wordEl, [
        'a coder.',
		'a hackathon organizer.',
		'a peer tutor.',
        'a graphic designer.',
        'a runner.',
		'a racewalker.',
        'a pianist.',
      ]);
    }
  </script>

</Layout>