---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Nav from '../components/Nav.astro';
import { projects } from '../data/projects';

const tags = [...new Set(projects.map((p) => p.tag))];
---

<Layout title="Kailey Liou">
  <Nav />
  <main>
    <div class="container">
      <a href="/#projects" class="btn-outline back">← Back home</a>
      <h1>All projects</h1>

      <div class="filters">
        <button class="filter" data-tag="all" aria-pressed="true">all</button>
        {tags.map((tag) => (
          <button class="filter" data-tag={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>

      <div class="grid">
        {projects.map((p) => (
          <div class="item" data-tag={p.tag}>
            <ProjectCard {...p} />
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    padding-block: var(--space-xl);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }

  .filter {
    border: 1px solid rgba(22, 40, 58, 0.25);
    background: transparent;
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font: inherit;
    cursor: pointer;
  }

  .filter[aria-pressed="true"] {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: var(--color-cream);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .item {
    display: flex;
  }

  .back {
    margin-bottom: var(--space-md);
  }

  .item[hidden] {
    display: none;
  }

  .item :global(.project-card) {
    flex: 1;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.item');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag;

      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

      items.forEach((item) => {
        item.hidden = !(tag === 'all' || item.dataset.tag === tag);
      });
    });
  });
</script>