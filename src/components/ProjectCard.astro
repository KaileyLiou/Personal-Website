---
interface Props {
  title: string;
  description: string;
  link: string;
  githubLink?: string;
  image: string;
  isDuplicate?: boolean;
}

const { title, description, link, githubLink, image, isDuplicate } = Astro.props;
---

<article class="project-card" aria-hidden={isDuplicate ? "true" : undefined}>
  <a href={link} target="_blank" rel="noopener noreferrer" class="project-image-link" tabindex={isDuplicate ? -1 : undefined}>
    <img src={image} alt={`Screenshot of ${title}`} class="project-image" loading="lazy" />
  </a>
  <div class="project-card-body">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="project-card-footer">
      <a href={link} target="_blank" rel="noopener noreferrer" class="project-view-link" tabindex={isDuplicate ? -1 : undefined}>
        Try it out →
      </a>
      {githubLink && (
        <a href={githubLink} target="_blank" rel="noopener noreferrer" aria-label="View source code" class="project-github" tabindex={isDuplicate ? -1 : undefined}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .31.21.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(22, 40, 58, 0.1);
  }

  .project-image-link {
    display: block;
  }

  .project-image {
    aspect-ratio: 16 / 10;
    width: 100%;
    object-fit: cover;
    display: block;
  }

  .project-card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-card h3 {
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
  }

  .project-card p {
    font-size: 0.9rem;
    opacity: 0.8;
    line-height: 1.5;
  }

  .project-card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    padding-top: var(--space-sm);
  }

  .project-view-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-blue);
    text-decoration: none;
  }

  .project-view-link:hover {
    text-decoration-line: underline;
    text-decoration-style: wavy;
    text-decoration-color: var(--color-yellow);
    text-underline-offset: 4px;
  }

  .project-github {
    margin-left: auto;
    color: var(--color-blue-dark);
    opacity: 0.6;
    text-decoration: none;
  }
</style>